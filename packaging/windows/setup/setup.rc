// Icon, manifest and version info of the setup. setup_config.h comes from build-installer.ps1.
#include <windows.h>
#include "setup_config.h"

1 ICON "nokturn.ico"
1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION SETUP_VERSION_COMMA
PRODUCTVERSION SETUP_VERSION_COMMA
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "zr3mb"
            VALUE "FileDescription", "Nokturn Setup"
            VALUE "FileVersion", SETUP_VERSION
            VALUE "ProductName", "Nokturn"
            VALUE "ProductVersion", SETUP_VERSION
            VALUE "LegalCopyright", "zr3mb"
            VALUE "OriginalFilename", "Nokturn-setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
